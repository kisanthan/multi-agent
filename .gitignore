.claude/
.idea/
.vscode/
*.swp
*~

# --- Generated artifacts ----------------------------------------------------
# Reproducible via `python -m data.generate` (fixed seed), and therefore do
# not belong in version control.
data/masterdata.db
data/masterdata.db-wal
data/masterdata.db-shm
data/manifest.json
data/inbox/*.pdf
data/checkpoints.sqlite
data/checkpoints.sqlite-wal
data/checkpoints.sqlite-shm

# Runtime state, written by the UI (ui/pages/models.py): per-agent model
# overrides. Machine-local operator configuration, not source.
data/model_overrides.json

