# Kopieren nach .env und anpassen.  Der Prototyp laeuft vollstaendig ohne
# Cloud-Keys (nur Ollama) -- das ist die Reproduzierbarkeitsanforderung aus
# Abschnitt 7 des Fachkonzepts und zugleich der Datenhoheits-Beleg.

# ---- Offene fachliche Festlegung: Buchungs-Agent (Prozess A) ---------------
# Unterhalb der Schwelle bucht der Agent automatisch (Human-on-the-loop),
# oberhalb ist eine Freigabe noetig (Human-in-the-loop). Beide Varianten sind
# damit in derselben Demo zeigbar.
BUCHUNG_SCHWELLE_EUR=10000

# Zulaessige Abweichung zwischen Zahlbetrag und Stammdaten-Betrag, bevor ein
# Klaerfall ausgeloest wird.
BETRAG_TOLERANZ_EUR=0.01

# ---- Modell-Bereitstellung -------------------------------------------------
# 'lokal'  = alles ueber Ollama, keine Cloud, kein Key noetig (Default)
# 'hybrid' = lesende Rollen lokal, kritische Schreibaktionen in der Cloud
# 'cloud'  = alles ueber die Anthropic-API
MODELL_MODUS=lokal

# Adresse der Ollama-Instanz. Das ist der einzige Schalter, der zwingend stimmen
# muss -- lokal oder ein Server im Netz (z.B. http://10.0.0.5:11434).
# Der Prototyp laedt KEINE Modelle. Bereitstellung erfolgt ausserhalb:
#     ollama serve
#     ollama pull <modell>
# Pruefen, ob alles bereit ist:
#     python demo.py --check
OLLAMA_BASE_URL=http://localhost:11434

# Namen der Modelle, die auf dieser Instanz bereitstehen sollen. Frei waehlbar --
# eintragen, was `ollama list` dort zeigt.
OLLAMA_MODELL_KLEIN=qwen3:8b
OLLAMA_MODELL_VISION=llama3.2-vision:11b

# Nur bei MODELL_MODUS=hybrid|cloud noetig.
# Modell-IDs und Preise Stand 17.07.2026 (wechseln quartalsweise).
ANTHROPIC_API_KEY=
CLOUD_MODELL_FRONTIER=claude-opus-4-8
CLOUD_MODELL_KLEIN=claude-haiku-4-5

# ---- Reader-Tool -----------------------------------------------------------
# 'pymupdf4llm' = schnell, CPU-only, keine Modellgewichte (Default)
# 'docling'     = spezialisierter On-Premise-Parser, laedt ~1-2 GB Gewichte
READER_PARSER=pymupdf4llm

# ---- Mock-Zielsysteme ------------------------------------------------------
NAVISION_URL=http://localhost:8001
ELO_URL=http://localhost:8002
