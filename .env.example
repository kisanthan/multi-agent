# Copy to .env and adjust. The prototype runs completely without cloud keys
# (Ollama only) -- that is the reproducibility requirement from section 7
# of the functional concept and at the same time the data-sovereignty proof.

# ---- Portal mode ------------------------------------------------------------
# admin = password login. The documented prototype administrator is installed
#         on first start and may upload, approve other users' cases and edit
#         configuration. Change the password for any shared installation.
# demo  = no login page. A role selector includes the two named identities
#         plus two additional synthetic demo people defined in code; all
#         policy, four-eyes, audit and target-system controls remain active.
PORTAL_MODE=demo
PORTAL_ADMIN_EMAIL=admin@prototype.local
PORTAL_ADMIN_PASSWORD=Admin-Prototype-2026!
DEMO_SUBMITTER_UPN=m.keller@chg-meridian.com
DEMO_APPROVER_UPN=s.hofmann@chg-meridian.com

# Allowed deviation between the paid amount and the master-data amount
# before an exception case is raised. The booking agent is always subject
# to approval regardless of amount (human-in-the-loop, Thesis §7.4) -- no
# amount threshold.
AMOUNT_TOLERANCE_EUR=0.01

# ---- Model provisioning -----------------------------------------------------
# The controlled profile permits standard processing only via local Ollama.
# Legacy values are parsed for compatibility, but runtime enforcement rejects
# unscoped cloud calls even if a UI or old configuration selects them.
MODEL_MODE=lokal

# Address of the Ollama instance. Runtime enforcement accepts localhost,
# 127.0.0.1 or ::1 only for standard classification and extraction.
# The prototype loads NO models. Provisioning happens outside it:
#     ollama serve
#     ollama pull <model>
# Check whether everything is ready:
#     python demo.py --check
OLLAMA_BASE_URL=http://localhost:11434

# Names of the models that should be available on this instance. Freely
# choosable -- enter what `ollama list` shows there.
OLLAMA_MODEL_SMALL=qwen3:8b
# llama3.2-vision:11b is the model named in the original functional
# concept, but failed to load in this project's own testing
# ("unknown model architecture: mllama" -- unrelated to the R1 schema-
# adherence issue in docs/limitations.md). qwen2.5vl:7b is confirmed working
# as of 2026-08-05.
OLLAMA_MODEL_VISION=qwen2.5vl:7b

# ---- Provider-neutral profiles --------------------------------------------
# These values are retained for configuration compatibility. Controlled
# standard execution accepts provider=ollama only.
LLM_ROUTER_PROVIDER=
LLM_ROUTER_MODEL=
LLM_PAYMENT_PROVIDER=
LLM_PAYMENT_MODEL=
LLM_INVOICE_PROVIDER=
LLM_INVOICE_MODEL=
CONFIGURATION_REVISION=1

# A separately reviewed layout proxy is configured through evidence files in
# .runtime_secrets/layout-deployment/. No cloud secret belongs in this file.

# ---- Reader tool -------------------------------------------------------------
# 'pymupdf4llm' = fast, CPU-only, no model weights (default)
# 'docling'     = specialized on-premise parser, loads ~1-2 GB of weights
READER_PARSER=pymupdf4llm

# ---- Mock target systems -----------------------------------------------------
NAVISION_URL=http://localhost:8001
ELO_URL=http://localhost:8002
